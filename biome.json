{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["src/**", "tests/**", "!tests/fixtures", "*.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "overrides": [
    {
      "includes": ["src/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 400,
                "skipBlankLines": true
              }
            }
          },
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "info",
              "options": {
                "maxLines": 40,
                "skipBlankLines": true
              }
            },
            "noExcessiveCognitiveComplexity": {
              "level": "info",
              "options": {
                "maxAllowedComplexity": 15
              }
            }
          },
          "nursery": {
            "noExcessiveNestedBlocks": "info"
          }
        }
      }
    },
    {
      "includes": ["src/web/main.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 1746,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/web/board-view.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 1457,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/web/view.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 603,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/web/messages.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 844,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/domain/digest.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 610,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    }
  ]
}

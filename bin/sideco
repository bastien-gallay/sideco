#!/bin/sh
# Resolves symlinks so `sideco` works from a PATH link as well as from the plugin.
self="$0"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in
    /*) self="$target" ;;
    *) self="$(dirname "$self")/$target" ;;
  esac
done
# Bun's installer puts it in ~/.bun/bin, which a hook's shell may not have in its PATH.
bun="$(command -v bun || true)"
if [ -z "$bun" ] && [ -x "${BUN_INSTALL:-$HOME/.bun}/bin/bun" ]; then bun="${BUN_INSTALL:-$HOME/.bun}/bin/bun"; fi
if [ -z "$bun" ]; then
  echo "sideco: Sideco runs on Bun 1.4 or later, not found. Install it with: curl -fsSL https://bun.sh/install | bash" >&2
  exit 1
fi
exec "$bun" "$(cd "$(dirname "$self")/.." && pwd)/src/cli/main.ts" "$@"
